---
const features = [
  {
    icon: 'apple',
    title: 'AI-Powered Nutritionist and Chef',
    description: "Snap photos of your meals for instant nutrition analysis. Get personalized recipes based on your body's unique needs and what's in your fridge.",
  },
  {
    icon: 'heart',
    title: 'Adaptive Fitness Coach',
    description: "Experience workouts that evolve with you. Get real-time feedback like 'This pace is optimal for your fat-burning zone' based on your exertion patterns.",
  },
  {
    icon: 'brain',
    title: 'CBT based mental support',
    description: 'Access powerful therapeutic techniques through human-like conversations. Connect your emotional and physical wellness for unprecedented insights.',
  },
];

const iconPaths: Record<string, string> = {
  apple: 'M18.71,19.5C17.88,20.74 17,21.95 15.66,21.97C14.32,22 13.89,21.18 12.37,21.18C10.84,21.18 10.37,21.95 9.1,22C7.79,22.05 6.8,20.68 5.96,19.47C4.25,17 2.94,12.45 4.7,9.39C5.57,7.87 7.13,6.91 8.82,6.88C10.1,6.86 11.32,7.75 12.11,7.75C12.89,7.75 14.37,6.68 15.92,6.84C16.57,6.87 18.39,7.1 19.56,8.82C19.47,8.88 17.39,10.1 17.41,12.63C17.44,15.65 20.06,16.66 20.09,16.67C20.06,16.74 19.67,18.11 18.71,19.5M13,3.5C13.73,2.67 14.94,2.04 15.94,2C16.07,3.17 15.6,4.35 14.9,5.19C14.21,6.04 13.07,6.7 11.95,6.61C11.8,5.46 12.36,4.26 13,3.5Z',
  heart: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z',
  brain: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z',
};
---

<section class="relative py-16 sm:py-24 md:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center mb-16 sm:mb-24" data-gsap-section-header>
    <div class="inline-block mb-3 px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-white/80 backdrop-blur-sm border border-gray-300" data-gsap-section-tag>
      <span class="text-gray-500">The Wellness Trinity</span>
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6" data-gsap-section-title>
      <span class="text-gray-500">Three Powers</span>
      <span class="block mt-1 text-gray-800">One Revolutionary App</span>
    </h2>
    <p class="text-lg sm:text-xl max-w-3xl mx-auto text-gray-600" data-gsap-section-desc>
      Coachie is the first platform to recognize a profound truth: your nutrition affects your mood, your emotions impact your eating, and your exercise influences both.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8" data-gsap-card-grid>
      {features.map((feature) => (
        <div
          class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-lg"
          data-gsap-card
        >
          <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full flex items-center justify-center mb-4 sm:mb-6 mx-auto bg-gray-100">
            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-gray-500" viewBox="0 0 24 24" fill="currentColor">
              <path d={iconPaths[feature.icon]} />
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4 text-gray-800">{feature.title}</h3>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
