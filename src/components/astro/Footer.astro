---

<footer class="relative py-8 sm:py-12 md:py-16 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6" data-gsap-footer>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-8 sm:mb-12">
      <!-- Brand -->
      <div class="sm:col-span-2 md:col-span-1">
        <div class="flex items-center space-x-2 mb-4">
          <Image
            src={mainIcon}
            alt="Coachie Logo"
            width={32}
            height={32}
            class="w-8 h-8 rounded-full object-cover"
            loading="lazy"
          />
          <span class="text-lg sm:text-xl font-bold text-gray-800">Coachie</span>
        </div>
        <p class="text-gray-600 text-sm sm:text-base">
          Transform your mind & body with the world's most advanced wellness AI.
        </p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Footer navigation">
        <h4 class="text-base sm:text-lg font-semibold mb-3 sm:mb-4 text-gray-800">Navigation</h4>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-gray-600 hover:text-gray-800 transition-colors text-sm sm:text-base link-hover">Home</a>
          </li>
          <li>
            <a href="/privacypolicy" class="text-gray-600 hover:text-gray-800 transition-colors text-sm sm:text-base link-hover">Privacy Policy</a>
          </li>
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h4 class="text-base sm:text-lg font-semibold mb-3 sm:mb-4 text-gray-800">Contact</h4>
        <ul class="space-y-2">
          <li>
            <a
              href={`mailto:${APP_CONFIG.email}`}
              class="text-gray-600 hover:text-gray-800 transition-colors text-sm sm:text-base break-all link-hover"
            >
              {APP_CONFIG.email}
            </a>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-base sm:text-lg font-semibold mb-3 sm:mb-4 text-gray-800">Follow Us</h4>
        <div class="flex space-x-3 sm:space-x-4">
          {socialLinks.map(social => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center border border-gray-300 text-gray-600 hover:text-gray-800 transition-colors social-hover"
              aria-label={`Follow Coachie on ${social.name}`}
            >
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="text-center text-xs sm:text-sm text-gray-400">
      <p>&copy; {currentYear} Coachie. All rights reserved.</p>
    </div>
  </div>
</footer>
