---
import { Image } from 'astro:assets';
import mainIcon from '../../assets/images/ic_main_icon.webp';

const currentPath = Astro.url.pathname;
const isPrivacyPage = currentPath === '/privacypolicy' || currentPath === '/privacypolicy/';
const APP_STORE = 'https://apps.apple.com/us/app/coachie-coach-chef-cbt/id6744700791';
---

<header id="site-header" class="fixed top-0 left-0 w-full z-40">
  <div class="max-w-7xl mx-auto px-2 sm:px-2 py-2 sm:py-2 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-2 sm:space-x-3 group">
      <div class="relative w-10 h-10 md:w-12 md:h-12 transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105">
        <Image
          src={mainIcon}
          alt="Coachie"
          width={48}
          height={48}
          class="w-full h-full rounded-full object-cover"
          loading="eager"
        />
      </div>
      <span class="text-xl md:text-3xl font-bold tracking-tight text-gray-800 transition-transform duration-300 group-hover:-translate-y-1">
        Coachie
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex space-x-12 lg:space-x-16 text-xl">
      <a
        href="/"
        class="relative link-hover transition-colors"
        style={`color: ${!isPrivacyPage ? '#495057' : '#ADB5BD'}`}
      >
        Home
      </a>
      <a
        href="/privacypolicy"
        class="relative link-hover transition-colors"
        style={`color: ${isPrivacyPage ? '#495057' : '#ADB5BD'}`}
      >
        Privacy Policy
      </a>
    </nav>

    <!-- Desktop Download Button -->
    <div class="hidden md:block">
      <a
        href={APP_STORE}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-hover group relative overflow-hidden px-4 lg:px-5 py-2 flex items-center space-x-1 rounded-full font-medium bg-gray-800 text-white border border-gray-300"
      >
        <span class="relative z-10 text-sm">Get App</span>
        <svg class="w-3 h-3 relative z-10 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-gray-800 p-1 focus:outline-2 focus:outline-offset-2 focus:outline-gray-800"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <svg id="menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 backdrop-blur-xl z-30 flex-col items-center justify-center space-y-8 bg-white/95 hidden"
    style="display: none;"
  >
    <a href="/" class="text-2xl sm:text-3xl font-bold text-gray-800" data-close-menu>Home</a>
    <a href="/privacypolicy" class="text-2xl sm:text-3xl font-bold text-gray-800" data-close-menu>Privacy Policy</a>
    <a
      href={APP_STORE}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 px-6 sm:px-8 py-3 sm:py-4 rounded-full text-white font-bold bg-gray-800 btn-hover"
      data-close-menu
    >
      Download Now
    </a>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!header || !menuBtn || !mobileMenu || !menuIcon || !closeIcon) return;

    let menuOpen = false;

    // Scroll effect (skipped when GSAP handles it on main page)
    if (!document.querySelector('[data-gsap-hero]')) {
      let lastScrollY = 0;
      const handleScroll = () => {
        const scrollY = window.scrollY;
        if (scrollY > 50) {
          header.style.backgroundColor = 'rgba(255, 255, 255, 0.95)';
          header.style.backdropFilter = 'blur(10px)';
          header.style.borderBottom = '1px solid rgba(173, 181, 189, 0.1)';
        } else {
          header.style.backgroundColor = 'transparent';
          header.style.backdropFilter = 'none';
          header.style.borderBottom = 'none';
        }
        lastScrollY = scrollY;
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // Mobile menu toggle
    menuBtn.addEventListener('click', () => {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu.style.display = 'flex';
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', 'Close navigation menu');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu.style.display = 'none';
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', 'Open navigation menu');
        document.body.style.overflow = '';
      }
    });

    // Close menu on link click
    mobileMenu.querySelectorAll('[data-close-menu]').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.style.display = 'none';
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        menuOpen = false;
      });
    });
  }

  // Support view transitions
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
