import run_1 from '../assets/images/run_1.webp';
import run_2 from '../assets/images/run_2.webp';
import run_3 from '../assets/images/run_3.webp';
import run_4 from '../assets/images/run_4.webp';
import run_5 from '../assets/images/run_5.webp';

// PerfectStay screenshots
import stay_1 from '../assets/images/stay_1.webp';
import stay_2 from '../assets/images/stay_2.webp';
import stay_3 from '../assets/images/stay_3.webp';
import stay_4 from '../assets/images/stay_4.webp';
import stay_5 from '../assets/images/stay_5.webp';

// Aunest screenshots
import aunest_1 from '../assets/images/aunest_1.webp';
import aunest_2 from '../assets/images/aunest_2.webp';
import aunest_3 from '../assets/images/aunest_3.webp';
import aunest_4 from '../assets/images/aunest_4.webp';
import aunest_5 from '../assets/images/aunest_5.webp';
import aunest_6 from '../assets/images/aunest_6.webp';
import aunest_7 from '../assets/images/aunest_7.webp';

const items = [
  {
    id: 1,
    title: "Remote for Samsung TV Smart",
    desc: "Move over the old Smart TV remote! Control your Samsung TV with your phone and say goodbye \u{1F44B} to your old bulky remote",
    tag: "10M+ Downloads",
    tagType: "downloads",
    screenshots: [remote_1, remote_2, remote_3, remote_4],
    appStoreLink: "https://apps.apple.com/in/app/remote-for-samsung-tv-smart/id6474010687",
    playStoreLink: "https://play.google.com/store/apps/details?id=com.controlla.remoteapp",
  },
  {
    id: 2,
    title: "Coachie - Coach | Chef | CBT",
    desc: "Transform your mind and body with personalised meal plans, AI chef and AI Cognitive Behavioral Therapy (CBT) based mental support.",
    tag: "10K+ Downloads",
    tagType: "downloads",
    screenshots: [coachie_1, coachie_2, coachie_3, coachie_4, coachie_5, coachie_6, coachie_7],
    appStoreLink: "https://apps.apple.com/in/app/coachie-coach-chef-cbt/id6744700791",
    playStoreLink: "https://play.google.com/store/apps/details?id=com.cc.caloriecoach",
  },
  {
    id: 3,
    title: "Foodzapp - Food Ordering",
    desc: "Order food from your favourite restaurants and get it delivered to your doorstep with ease.",
    tag: "10K+ Downloads",
    tagType: "downloads",
    screenshots: [foodz_1, foodz_2, foodz_3, foodz_4, foodz_5],
    playStoreLink: "https://play.google.com/store/apps/details?id=com.order.spryntz",
    appStoreLink: "https://apps.apple.com/in/app/foodzapp/id6450407859",
  },
