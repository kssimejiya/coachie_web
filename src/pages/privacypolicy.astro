---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/astro/Footer.astro';

const title = 'Privacy Policy | Coachie - AI Coach, Chef & CBT Therapist';
const description = 'Privacy Policy for Coachie wellness app. Learn how we collect, use, and protect your personal data.';
const canonical = 'https://coachie-ai.com/privacypolicy';
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
>
  <main id="main-content" class="min-h-screen pt-20 sm:pt-32 pb-16 sm:pb-24 px-4 sm:px-6 max-w-4xl mx-auto">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-8 sm:mb-12 text-gray-500">
      Privacy Policy
    </h1>

    <div class="prose prose-sm sm:prose-lg max-w-none space-y-8 sm:space-y-12">
      <!-- Introduction -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Introduction</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Last update April 20, 2025</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">This Privacy Policy explains how Coachie ("the Company," "We," "Us," or "Our") gathers, uses, and shares your information when you use our Service. It also outlines your privacy rights and explains how the law protects you.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">By using the Service, you consent to the collection and use of your information in line with this Privacy Policy. We utilise your personal data to enhance the Service we provide.</p>
      </section>

      <!-- Interpretation and Definitions -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Interpretation and Definitions</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Words where the first letter is capitalised carry meanings defined under the conditions stated below. Regardless of whether they appear in singular or plural form, these definitions hold the same meaning.</p>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Definitions</h3>
        <div class="space-y-3 sm:space-y-4">
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Account</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">A unique profile created for you to access and use our Service or certain parts of it.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Affiliate</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Any entity that controls, is controlled by, or is under shared control with a party, where "control" refers to holding at least 50% of the shares, equity interest, or other securities able to vote for directors or other managerial authority.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Application</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Any software or app provided by Coachie</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Company</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Coachie (referred to as "the Company," "We," "Us," or "Our" in this Agreement).</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Country</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Refers to Israel.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Device</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Any device that can connect to the Service, such as a computer, cellphone, or digital tablet.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Personal Data</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Any information related to an identified or identifiable individual.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Service</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Refers to the Application.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Service Provider</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Any natural or legal individual who processes data on behalf of the Company.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">Usage Data</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">Data collected automatically, whether generated by the use of the Service or from the Service infrastructure itself.</dd></div>
          <div class="border-l-2 border-gray-200 pl-4"><dt class="font-semibold text-gray-700 text-sm sm:text-base">You</dt><dd class="text-gray-600 text-sm sm:text-base leading-relaxed mt-1">The individual accessing or using the Service, or the business or legal entity represented by that individual.</dd></div>
        </div>
      </section>

      <!-- Collecting Data -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Collecting and Using Your Personal Data</h2>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Types of Data Collected</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">While using Our Service, we might request that you provide certain information that can be used to reach out to or identify you.</p>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Personal Data</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We may collect personally identifiable information that can be used to contact or identify you.</p>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Usage Data</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Usage Data is automatically gathered while you use the Service. This may include details such as your Device's Internet Protocol (IP) address, browser type, browser version, the specific pages of our Service you visit, the date and time of your visit, the duration spent on those pages, unique device identifiers, and other diagnostic data.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">If you access the Service via a mobile device, we may also automatically gather information such as the mobile device type, its unique ID, its IP address, its operating system, the mobile Internet browser type, unique device identifiers, and other diagnostic data.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Additionally, we may collect data your browser transmits whenever you visit or access our Service via a mobile device.</p>
      </section>

      <!-- Use of Data -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Use of Your Personal Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Coachie may use the Personal Data it collects for the following objectives:</p>
        <ul class="text-gray-600 mb-4 list-disc pl-4 sm:pl-6 space-y-2 sm:space-y-3">
          <li class="text-sm sm:text-base leading-relaxed">Providing and maintaining the Service: Including monitoring Service usage.</li>
          <li class="text-sm sm:text-base leading-relaxed">Managing Your Account: Overseeing your registration as a user.</li>
          <li class="text-sm sm:text-base leading-relaxed">Fulfilling contracts: Creating, ensuring compliance with, and carrying out any purchase contracts.</li>
          <li class="text-sm sm:text-base leading-relaxed">Contacting You: Using email, phone, SMS, or other digital communication methods to deliver updates.</li>
          <li class="text-sm sm:text-base leading-relaxed">Offering updates and offers: Providing you with news, special deals, and general information.</li>
          <li class="text-sm sm:text-base leading-relaxed">Managing your requests: Addressing and handling any inquiries you make to us.</li>
          <li class="text-sm sm:text-base leading-relaxed">Business transfers: Evaluating or executing mergers, divestitures, restructurings, or other sales or transfers of assets.</li>
          <li class="text-sm sm:text-base leading-relaxed">Other purposes: Utilising your data for analysing usage, spotting trends, and refining our Service.</li>
        </ul>
      </section>

      <!-- Exercise Data -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Exercise Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We may process step counts or exercise-related information to enhance user experience and support fitness goals more effectively. All exercise data is processed solely on your device and not retained on our servers. You have the option to delete your exercise data at any time.</p>
      </section>

      <!-- Retention -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Retention of Your Personal Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Coachie will maintain your Personal Data only for as long as is necessary to fulfill the objectives detailed in this Privacy Policy. We will keep and use your data to the extent needed to adhere to legal obligations, settle disputes, and apply our legal agreements and policies.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Usage Data is typically preserved for a shorter window, unless it's employed to reinforce security or enhance our Service, or we are legally compelled to retain it longer.</p>
      </section>

      <!-- Transfer -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Transfer of Your Personal Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Your information, including Personal Data, may be processed at locations where the Company or its service providers operate. Thus, your information could be moved to—and stored on—computers in jurisdictions where data protection laws may differ from your own.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">By consenting to this Privacy Policy and submitting your data, you indicate your approval of this transfer. We will take all reasonable measures to ensure your data is handled securely and in compliance with this Privacy Policy.</p>
      </section>

      <!-- Delete -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Delete Your Personal Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">You retain the right to delete or request deletion of your Personal Data that we have collected. Our Service may give you ways to remove certain personal information within the platform itself.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">You can modify, correct, or remove your information anytime by accessing your Account settings (if available). You can also get in touch with us to request that we grant you access to, correct, or delete any personal information provided to us.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Please bear in mind that we may need to retain specific data if required by law or for other valid reasons.</p>
      </section>

      <!-- Disclosure -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Disclosure of Your Personal Data</h2>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Business Transactions</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">If Coachie is involved in a merger, acquisition, or sale of assets, your Personal Data may be transferred. We will notify you beforehand if your Personal Data is transferred and becomes subject to a different Privacy Policy.</p>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Law Enforcement</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">In certain cases, the Company might need to disclose your Personal Data due to legal requirements or valid requests from public authorities.</p>
        <h3 class="text-lg sm:text-xl font-semibold text-gray-600 mb-3">Other Legal Requirements</h3>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We may disclose your Personal Data if we sincerely believe such action is necessary to:</p>
        <ul class="text-gray-600 mb-4 list-disc pl-4 sm:pl-6 space-y-1 sm:space-y-2">
          <li class="text-sm sm:text-base leading-relaxed">Abide by a legal obligation</li>
          <li class="text-sm sm:text-base leading-relaxed">Protect and defend the Company's rights or property</li>
          <li class="text-sm sm:text-base leading-relaxed">Investigate or prevent potential wrongdoing connected to the Service</li>
          <li class="text-sm sm:text-base leading-relaxed">Safeguard the personal safety of Service users or the public</li>
          <li class="text-sm sm:text-base leading-relaxed">Shield against legal liability</li>
        </ul>
      </section>

      <!-- Security -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Security of Your Personal Data</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We prioritize the protection of your Personal Data. However, remember that no method of online transmission or electronic storage is entirely secure. While we exercise commercially acceptable precautions to shield your Personal Data, absolute security cannot be promised.</p>
      </section>

      <!-- Children -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Children's Privacy</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Our Service does not target individuals under 13 years of age. We do not knowingly collect personally identifying information from anyone under 13. If you are a parent or guardian and discover your child has provided Personal Data to us, please contact us.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">If your local laws require parental consent for data processing and you are under that age, we may need your parent's consent before collecting or using that information.</p>
      </section>

      <!-- Links -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Links to Other Websites</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">Our Service might include links to external sites that we do not operate. We strongly encourage you to examine the Privacy Policy of every site you visit. We have no control over, and are not responsible for, the content, privacy policies, or practices of any third-party websites or services.</p>
      </section>

      <!-- Changes -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Changes to This Privacy Policy</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We may periodically revise this Privacy Policy. Any changes will be posted on this page, along with a new "Last updated" date.</p>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">We will let you know of any significant adjustments via email and/or a prominent notice on our Service, prior to those changes becoming valid.</p>
      </section>

      <!-- Contact -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-gray-600 mb-3 sm:mb-4">Contact Us</h2>
        <p class="text-gray-600 mb-4 text-sm sm:text-base leading-relaxed">If you have questions about this Privacy Policy, feel free to reach out to us:</p>
        <p class="text-gray-600 text-sm sm:text-base mb-2">By email:</p>
        <a href="mailto:contact@coachie-ai.com" class="text-gray-800 font-medium hover:text-gray-600 transition-colors text-sm sm:text-base">contact@coachie-ai.com</a>
      </section>
    </div>

    <a
      href="/"
      class="mt-8 sm:mt-12 px-4 sm:px-6 py-2 sm:py-3 inline-flex items-center space-x-2 border rounded-full transition-colors text-gray-600 border-gray-300 hover:bg-gray-50 btn-hover"
    >
      <svg class="rotate-180 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <span>Back to Home</span>
    </a>
  </main>
  <Footer />
</MainLayout>
