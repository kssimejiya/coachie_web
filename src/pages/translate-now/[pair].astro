---
import TranslateNowLayout from '../../layouts/TranslateNowLayout.astro';
import { Image } from 'astro:assets';
import translateIcon from '../../assets/images/translate_icon.webp';
import { LANGUAGES, getAllPairs, PHRASE_KEYS, PHRASE_LABELS, type Language } from '../../data/translation-languages';
import { PHRASES } from '../../data/translation-phrases';

export function getStaticPaths() {
  return getAllPairs().map(({ source, target, slug }) => ({
    params: { pair: slug },
    props: { source, target },
  }));
}

const { source, target } = Astro.props as { source: Language; target: Language };
const APP_STORE_URL = 'https://apps.apple.com/in/app/translate-now-ai-translator/id6759827185';
const SUPPORT_EMAIL = 'contact@coachie-ai.com';
const pairTitle = `${source.name} to ${target.name}`;
const pairSlug = `${source.slug}-to-${target.slug}`;
const canonicalUrl = `https://coachie-ai.com/translate-now/${pairSlug}`;

// Phrases for this pair
const sourcePhrases = PHRASES[source.code] || PHRASES['en'];
const targetPhrases = PHRASES[target.code] || PHRASES['en'];

// Feature highlights relevant to this pair
const pairFeatures: Array<{ title: string; desc: string; icon: string }> = [];
if (source.offlineSupported && target.offlineSupported) pairFeatures.push({ title: 'Offline Translation', desc: `Translate ${source.name} to ${target.name} without internet. Download both language packs once (5-50MB each) and translate anywhere via ML Kit.`, icon: 'M3 3l8.735 8.735m0 0a.374.374 0 11.53.53m-.53-.53l.53.53m0 0L21 21' });
if (source.voiceCloneSupported && target.voiceCloneSupported) pairFeatures.push({ title: 'Voice Clone Translation', desc: `Hear ${source.name} to ${target.name} translations in your own cloned voice. Record 10 seconds, get AI voice synthesis via ElevenLabs.`, icon: 'M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424' });
if (target.transliterationAvailable) pairFeatures.push({ title: `${target.name} Transliteration`, desc: `Every ${target.name} translation includes romanized pronunciation so you can read ${target.script} script phonetically.`, icon: 'M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3' });
if (source.ocrSupported && target.ocrSupported) pairFeatures.push({ title: 'Camera Translation', desc: `Point your iPhone camera at ${source.name} text — signs, menus, documents — and see instant ${target.name} translations via OCR.`, icon: 'M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574' });
if (target.rtl) pairFeatures.push({ title: 'RTL Support', desc: `Full right-to-left rendering for ${target.name}. Document translation preserves RTL layout, fonts, and formatting perfectly.`, icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5' });
pairFeatures.push({ title: 'Keyboard Translator', desc: `Type in ${source.name} in WhatsApp, iMessage, or any app — the built-in keyboard translates and sends in ${target.name} automatically.`, icon: 'M3.75 9h16.5m-16.5 6.75h16.5' });
pairFeatures.push({ title: '9 Translation Tones', desc: `Translate ${source.name} to ${target.name} in Standard, Formal, Casual, Friendly, Professional, Simple, Literary, Funny, or Flirty tone.`, icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25' });
pairFeatures.push({ title: 'AI Context & Examples', desc: `Every ${source.name} to ${target.name} translation returns usage examples, synonyms, and cultural context powered by GPT-4o.`, icon: 'M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5' });

// FAQ items for this pair
const FAQ_ITEMS = [
  { q: `Can I translate ${source.name} to ${target.name} offline?`, a: source.offlineSupported && target.offlineSupported ? `Yes, both ${source.name} and ${target.name} are available for offline translation via Google ML Kit. Download the language packs once (5-50MB each) and translate without internet anywhere.` : `${source.name} to ${target.name} translation requires an internet connection for cloud-based GPT-4o translation. However, ${source.offlineSupported ? source.name : target.name} is available offline.` },
  { q: `How accurate is ${source.name} to ${target.name} AI translation?`, a: `TranslateNow uses GPT-4o for ${source.name} to ${target.name} translation, which provides contextual understanding of tone, idiom, and cultural nuance — significantly more accurate than word-by-word translation engines. The AI considers the full sentence context before translating.` },
  { q: `Can I hear ${target.name} translations spoken aloud?`, a: `Yes. TranslateNow offers 7 neural AI voices (Coral, Alloy, Echo, Fable, Onyx, Nova, Shimmer) to speak ${target.name} translations. You can also clone your own voice to hear translations in your voice speaking ${target.name}.` },
  { q: `Does TranslateNow translate ${source.name} to ${target.name} in real-time conversation?`, a: `Yes. The AI Conversation mode uses OpenAI Realtime API for bidirectional ${source.name}–${target.name} voice translation. Speak in ${source.name}, hear the response in ${target.name} — with automatic language detection and neural voice output.` },
  { q: `Can I translate ${source.name} documents (PDF/DOCX) to ${target.name}?`, a: `Yes. Import PDF, DOCX, TXT, or photo documents in ${source.name}. TranslateNow extracts all text blocks, translates each to ${target.name} via GPT-4o, and reconstructs the document preserving the original formatting, fonts, and layout.` },
];

// Structured data
const faqSD = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ_ITEMS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const breadcrumbSD = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coachie-ai.com' },
  { '@type': 'ListItem', position: 2, name: 'TranslateNow', item: 'https://coachie-ai.com/translate-now' },
  { '@type': 'ListItem', position: 3, name: `${source.name} to ${target.name}`, item: canonicalUrl },
]});
const howToSD = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: `How to translate ${source.name} to ${target.name}`, description: `Translate ${source.name} to ${target.name} in 3 steps with TranslateNow AI Translator.`, totalTime: 'PT10S', step: [
  { '@type': 'HowToStep', position: 1, name: 'Enter your text', text: `Type, speak, or photograph ${source.name} text using voice input, keyboard, camera OCR, or document import.` },
  { '@type': 'HowToStep', position: 2, name: 'AI translates with context', text: `GPT-4o analyzes tone, intent, and cultural nuance to produce accurate ${target.name} translation with examples and synonyms.` },
  { '@type': 'HowToStep', position: 3, name: 'Listen, copy, or share', text: `Hear the ${target.name} translation spoken by AI voice or your cloned voice. Copy, share, or export the result.` },
]});
---

<TranslateNowLayout
  title={`Translate ${source.name} to ${target.name} — AI Voice, Camera, AR & Offline | TranslateNow`}
  description={`Translate ${source.name} to ${target.name} with AI voice cloning, camera OCR, AR translation, document translation, offline mode, 9 tones, and keyboard translator. ${source.speakersShort} ${source.name} speakers to ${target.speakersShort} ${target.name} speakers. Free download.`}
  canonical={canonicalUrl}
  lang="en"
  keywords={`${source.name} to ${target.name} translator, translate ${source.name} to ${target.name}, ${source.name} ${target.name} translation app, ${source.slug} to ${target.slug} translator iPhone, best ${source.name} to ${target.name} app, AI ${source.name} ${target.name} translator, offline ${source.name} to ${target.name}`}
  structuredData={[faqSD, breadcrumbSD, howToSD]}
>
  <noscript><style>{`[data-gsap],[data-gsap="fade-up"],.tn-glass-card,.tn-faq-item{opacity:1!important;visibility:visible!important;transform:none!important}`}</style></noscript>

  <nav class="tn-nav" aria-label="Main navigation">
    <div class="max-w-6xl mx-auto h-full flex items-center justify-between px-5 sm:px-6 lg:px-8">
      <a href="/translate-now" class="flex items-center gap-2.5 no-underline group"><Image src={translateIcon} alt="TranslateNow app icon" class="w-8 h-8 rounded-xl object-cover" style="box-shadow: 0 2px 8px rgba(0,0,0,0.3);" width={96} height={96} /><span class="font-bold text-[15px] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">TranslateNow</span></a>
      <div class="hidden sm:flex items-center gap-3">
        <a href="/translate-now" class="text-xs px-3 py-1.5 rounded-lg transition-all duration-200 no-underline hover:bg-white/5" style="color: var(--tn-text-muted);">All Languages</a>
        <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn">Download</a>
      </div>
    </div>
  </nav>

  <main id="main-content">
    <!-- HERO -->
    <section class="relative min-h-[70vh] flex flex-col justify-center px-5 sm:px-6 lg:px-8 pt-20 pb-16 overflow-hidden" style="background: var(--tn-bg-primary);">
      <div class="absolute top-1/2 left-1/2 pointer-events-none" style="width: 800px; height: 800px; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(255,107,74,0.10) 0%, transparent 65%);"></div>
      <div class="max-w-5xl mx-auto relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium mb-6" style="background: var(--tn-coral-bg); color: var(--tn-soft-coral); border: 1px solid rgba(255,107,74,0.12);">
          <span class="w-2 h-2 rounded-full" style="background: var(--tn-coral-fire);"></span>
          <span>{source.speakersShort} speakers → {target.speakersShort} speakers</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-extrabold leading-[1.1] mb-6 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">
          Translate {source.name} to {target.name} <span class="tn-gradient-text">with AI</span>
        </h1>
        <p class="text-lg sm:text-xl mb-4 max-w-2xl mx-auto leading-relaxed" style="color: var(--tn-text-secondary);">
          AI-powered {source.name} to {target.name} translation with voice cloning, camera OCR, AR overlays, document translation, 9 tones, offline mode, and keyboard translator for WhatsApp & iMessage.
        </p>
        <p class="text-sm mb-10 max-w-xl mx-auto" style="color: var(--tn-text-muted);">
          {source.nativeName} → {target.nativeName} · {target.script} script {target.transliterationAvailable ? '· Transliteration included' : ''} {source.offlineSupported && target.offlineSupported ? '· Offline available' : ''}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn tn-coral-btn-large">
            Download Free — Translate {source.name} to {target.name}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- QUICK GREETING -->
    <section class="py-10 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle); border-bottom: 1px solid var(--tn-bg-border-subtle);">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-8 flex-wrap">
          <div class="text-center">
            <span class="text-xs font-medium block mb-1" style="color: var(--tn-text-muted);">{source.name}</span>
            <span class="text-2xl sm:text-3xl font-bold" style="color: var(--tn-text-primary); font-family: var(--font-display);">{source.greeting}</span>
          </div>
          <svg class="w-6 h-6 flex-shrink-0" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          <div class="text-center">
            <span class="text-xs font-medium block mb-1" style="color: var(--tn-text-muted);">{target.name}</span>
            <span class="text-2xl sm:text-3xl font-bold" style="color: var(--tn-text-primary); font-family: var(--font-display);">{target.greeting}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMON PHRASES TABLE -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3" /></svg>Common phrases</div>
          <h2 class="text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">
            20 Essential {source.name} to {target.name} Phrases
          </h2>
          <p class="text-base max-w-xl mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">
            The most useful phrases for travelers, students, and professionals translating between {source.name} and {target.name}.
          </p>
        </div>
        <div class="tn-glass-card !p-0 overflow-hidden" style="cursor: default; transform: none !important;">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr>
                  <th class="text-left py-3.5 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle);">Phrase</th>
                  <th class="text-left py-3.5 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-coral-fire); border-bottom: 1px solid var(--tn-bg-border-subtle); background: rgba(255,107,74,0.04);">{source.name}</th>
                  <th class="text-left py-3.5 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-coral-fire); border-bottom: 1px solid var(--tn-bg-border-subtle); background: rgba(255,107,74,0.04);">{target.name}</th>
                </tr>
              </thead>
              <tbody>
                {PHRASE_KEYS.map((key, i) => {
                  const sp = sourcePhrases[key];
                  const tp = targetPhrases[key];
                  return (
                    <tr style={i < PHRASE_KEYS.length - 1 ? `border-bottom: 1px solid var(--tn-bg-border-subtle);` : ''}>
                      <td class="py-3 px-4 text-xs font-medium" style="color: var(--tn-text-muted);">{PHRASE_LABELS[key]}</td>
                      <td class="py-3 px-4" style="background: rgba(255,107,74,0.01);">
                        <span class="text-sm font-medium block" style="color: var(--tn-text-primary);">{sp.text}</span>
                        {sp.transliteration && <span class="text-xs italic" style="color: var(--tn-text-muted);">{sp.transliteration}</span>}
                      </td>
                      <td class="py-3 px-4" style="background: rgba(255,107,74,0.01);">
                        <span class="text-sm font-medium block" style="color: var(--tn-text-primary);">{tp.text}</span>
                        {tp.transliteration && <span class="text-xs italic" style="color: var(--tn-text-muted);">{tp.transliteration}</span>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
        <p class="text-center text-xs mt-4" style="color: var(--tn-text-hint);">
          TranslateNow translates 135+ languages beyond these common phrases — with AI context, examples, and synonyms for every translation.
        </p>
      </div>
    </section>

    <!-- FEATURES FOR THIS PAIR -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-gradient-dark);">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25" /></svg>{source.name} to {target.name} features</div>
          <h2 class="text-3xl sm:text-4xl font-extrabold mb-4 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">
            Why TranslateNow for {source.name} to {target.name}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {pairFeatures.map((f) => (
            <div class="tn-glass-card group" data-gsap="fade-up">
              <div class="tn-icon-box mb-3">
                <svg class="w-5 h-5" style="color: var(--tn-soft-coral);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg>
              </div>
              <h3 class="text-base font-bold mb-2" style="color: var(--tn-text-primary); font-family: var(--font-display);">{f.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--tn-text-secondary);">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CULTURAL CONTEXT -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="tn-glass-card" data-gsap="fade-up">
            <h3 class="text-lg font-bold mb-4" style="color: var(--tn-text-primary); font-family: var(--font-display);">About {source.name}</h3>
            <ul class="space-y-3 text-sm" style="color: var(--tn-text-secondary);">
              <li><strong style="color: var(--tn-text-primary);">Speakers:</strong> {source.speakers}</li>
              <li><strong style="color: var(--tn-text-primary);">Script:</strong> {source.script}</li>
              <li><strong style="color: var(--tn-text-primary);">Main countries:</strong> {source.countries.slice(0, 4).join(', ')}</li>
              <li><strong style="color: var(--tn-text-primary);">Dialects:</strong> {source.dialects.join(', ')}</li>
              <li><strong style="color: var(--tn-text-primary);">Offline:</strong> {source.offlineSupported ? '✓ Available (ML Kit)' : '✗ Cloud only'}</li>
            </ul>
            <div class="mt-4 p-3 rounded-lg" style="background: rgba(255,107,74,0.05); border: 1px solid rgba(255,107,74,0.1);">
              <p class="text-xs leading-relaxed" style="color: var(--tn-soft-coral);">💡 {source.funFact}</p>
            </div>
          </div>
          <div class="tn-glass-card" data-gsap="fade-up">
            <h3 class="text-lg font-bold mb-4" style="color: var(--tn-text-primary); font-family: var(--font-display);">About {target.name}</h3>
            <ul class="space-y-3 text-sm" style="color: var(--tn-text-secondary);">
              <li><strong style="color: var(--tn-text-primary);">Speakers:</strong> {target.speakers}</li>
              <li><strong style="color: var(--tn-text-primary);">Script:</strong> {target.script}</li>
              <li><strong style="color: var(--tn-text-primary);">Main countries:</strong> {target.countries.slice(0, 4).join(', ')}</li>
              <li><strong style="color: var(--tn-text-primary);">Dialects:</strong> {target.dialects.join(', ')}</li>
              <li><strong style="color: var(--tn-text-primary);">Offline:</strong> {target.offlineSupported ? '✓ Available (ML Kit)' : '✗ Cloud only'}</li>
            </ul>
            <div class="mt-4 p-3 rounded-lg" style="background: rgba(255,107,74,0.05); border: 1px solid rgba(255,107,74,0.1);">
              <p class="text-xs leading-relaxed" style="color: var(--tn-soft-coral);">💡 {target.funFact}</p>
            </div>
          </div>
        </div>
        <!-- Travel & Formality Tips -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="tn-glass-card" data-gsap="fade-up">
            <h4 class="text-sm font-bold mb-2" style="color: var(--tn-coral-fire);">🗣 Formality tip for {target.name}</h4>
            <p class="text-sm" style="color: var(--tn-text-secondary);">{target.formalityNote}</p>
          </div>
          <div class="tn-glass-card" data-gsap="fade-up">
            <h4 class="text-sm font-bold mb-2" style="color: var(--tn-coral-fire);">✈️ Travel tip</h4>
            <p class="text-sm" style="color: var(--tn-text-secondary);">{target.travelTip}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARISON: TranslateNow vs Google Translate for this pair -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-gradient-dark);">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">
            {source.name} to {target.name}: TranslateNow vs Google Translate
          </h2>
          <p class="text-sm" style="color: var(--tn-text-muted);">Features for this specific language pair.</p>
        </div>
        <div class="tn-glass-card !p-0 overflow-hidden" style="cursor: default; transform: none !important;">
          <table class="w-full text-sm">
            <thead><tr>
              <th class="text-left py-3 px-4 text-xs uppercase font-bold" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle);">Feature</th>
              <th class="text-center py-3 px-4 text-xs uppercase font-bold" style="color: var(--tn-coral-fire); border-bottom: 1px solid var(--tn-bg-border-subtle);">TranslateNow</th>
              <th class="text-center py-3 px-4 text-xs uppercase font-bold" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle);">Google Translate</th>
            </tr></thead>
            <tbody>
              {[
                { f: 'Voice cloning (your voice)', tn: '✓', gt: '✗' },
                { f: 'AR real-time translation', tn: '✓', gt: '✗' },
                { f: 'AI writing tools (5 built-in)', tn: '✓', gt: '✗' },
                { f: 'Keyboard translator (any app)', tn: '✓', gt: '✗' },
                { f: 'Document translation (PDF/DOCX)', tn: '✓', gt: '✗' },
                { f: '9 translation tones', tn: '✓', gt: '✗' },
                { f: 'AI context + examples + synonyms', tn: '✓', gt: '✗' },
                { f: `${target.name} transliteration`, tn: target.transliterationAvailable ? '✓' : '—', gt: target.transliterationAvailable ? '✓' : '—' },
                { f: `Offline ${source.name}→${target.name}`, tn: source.offlineSupported && target.offlineSupported ? '✓' : '✗', gt: '✓' },
                { f: 'System translator (iOS 18.4+)', tn: '✓', gt: '✗' },
              ].map((r, i) => (
                <tr style={i < 9 ? 'border-bottom: 1px solid var(--tn-bg-border-subtle);' : ''}>
                  <td class="py-3 px-4" style="color: var(--tn-text-secondary);">{r.f}</td>
                  <td class="text-center py-3 px-4 font-medium" style={`color: ${r.tn === '✓' ? 'var(--tn-coral-fire)' : 'var(--tn-text-hint)'};`}>{r.tn}</td>
                  <td class="text-center py-3 px-4 font-medium" style={`color: ${r.gt === '✓' ? 'var(--tn-text-muted)' : 'var(--tn-text-hint)'};`}>{r.gt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">
            {source.name} to {target.name} Translation FAQ
          </h2>
        </div>
        <div class="space-y-2.5">
          {FAQ_ITEMS.map((faq) => (
            <div class="tn-faq-item rounded-xl overflow-hidden" style="background: var(--tn-bg-surface); border: 1px solid var(--tn-bg-border-subtle);" data-gsap="fade-up">
              <button class="tn-faq-btn w-full flex items-center justify-between p-5 text-left transition-colors hover:bg-white/[0.02]">
                <h3 class="text-sm font-semibold pr-4" style="color: var(--tn-text-primary);">{faq.q}</h3>
                <svg class="w-4 h-4 flex-shrink-0 tn-faq-chevron" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
              </button>
              <div class="tn-faq-content"><div class="px-5 pb-5"><p class="text-sm leading-relaxed" style="color: var(--tn-text-secondary);">{faq.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INTERNAL LINKS -->
    <section class="py-16 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle);">
      <div class="max-w-5xl mx-auto">
        <h3 class="text-lg font-bold mb-6 text-center" style="color: var(--tn-text-primary); font-family: var(--font-display);">More {source.name} translation pairs</h3>
        <div class="flex flex-wrap justify-center gap-2">
          {LANGUAGES.filter(l => l.code !== source.code && l.code !== target.code).map(l => (
            <a href={`/translate-now/${source.slug}-to-${l.slug}`} class="text-xs px-3 py-1.5 rounded-lg no-underline transition-all hover:bg-white/5" style="color: var(--tn-text-muted); border: 1px solid var(--tn-bg-border-subtle);">
              {source.name} → {l.name}
            </a>
          ))}
        </div>
        <h3 class="text-lg font-bold mb-6 mt-10 text-center" style="color: var(--tn-text-primary); font-family: var(--font-display);">More {target.name} translation pairs</h3>
        <div class="flex flex-wrap justify-center gap-2">
          {LANGUAGES.filter(l => l.code !== target.code && l.code !== source.code).map(l => (
            <a href={`/translate-now/${l.slug}-to-${target.slug}`} class="text-xs px-3 py-1.5 rounded-lg no-underline transition-all hover:bg-white/5" style="color: var(--tn-text-muted); border: 1px solid var(--tn-bg-border-subtle);">
              {l.name} → {target.name}
            </a>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/translate-now" class="text-xs underline transition-colors hover:text-white/60" style="color: var(--tn-soft-coral);">← Back to TranslateNow</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-5 sm:px-6 lg:px-8 text-center relative overflow-hidden" style="background: var(--tn-bg-primary);">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] pointer-events-none" style="background: radial-gradient(circle, rgba(255,107,74,0.12) 0%, transparent 60%);"></div>
      <div class="max-w-2xl mx-auto relative z-10">
        <Image src={translateIcon} alt="TranslateNow icon" class="w-14 h-14 rounded-2xl mx-auto mb-6" style="box-shadow: 0 8px 32px rgba(255,107,74,0.2);" width={192} height={192} />
        <h2 class="text-2xl sm:text-3xl font-extrabold mb-4 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">
          Start translating {source.name} to {target.name} today
        </h2>
        <p class="text-sm mb-8" style="color: var(--tn-text-secondary);">
          Download TranslateNow free. Voice cloning, AR translation, documents, offline & 135+ languages.
        </p>
        <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn tn-coral-btn-large">
          Download Free
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-8 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle);">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <a href="/translate-now" class="flex items-center gap-2 no-underline"><Image src={translateIcon} alt="TranslateNow" class="w-6 h-6 rounded-lg" width={96} height={96} /><span class="font-bold text-xs" style="color: var(--tn-text-primary);">TranslateNow</span></a>
        <div class="flex items-center gap-3 text-xs" style="color: var(--tn-text-muted);">
          <a href="https://coachie-ai.com/privacy-policy-translation-app" class="hover:underline" style="color: var(--tn-text-muted);">Privacy</a>
          <span>·</span>
          <a href="https://coachie-ai.com/terms-of-use-translation-app" class="hover:underline" style="color: var(--tn-text-muted);">Terms</a>
          <span>·</span>
          <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:underline" style="color: var(--tn-text-muted);">Support</a>
        </div>
      </div>
    </footer>
  </main>

  <!-- FAQ Override -->
  <style is:inline>
    .tn-faq-content { height: auto !important; max-height: 0 !important; overflow: hidden !important; transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease !important; opacity: 0 !important; }
    .tn-faq-item.faq-active .tn-faq-content { max-height: 2000px !important; opacity: 1 !important; }
    .tn-faq-item.faq-active .tn-faq-chevron { transform: rotate(180deg); }
  </style>
  <script is:inline>
    window.addEventListener('load', function() {
      document.querySelectorAll('.tn-faq-content').forEach(function(c) { c.style.removeProperty('height'); c.style.removeProperty('overflow'); });
      document.querySelectorAll('.tn-faq-btn').forEach(function(oldBtn) {
        var newBtn = oldBtn.cloneNode(true); oldBtn.parentNode.replaceChild(newBtn, oldBtn);
        newBtn.addEventListener('click', function(e) {
          e.preventDefault(); e.stopPropagation();
          var item = newBtn.closest('.tn-faq-item'); if (!item) return;
          var wasActive = item.classList.contains('faq-active');
          document.querySelectorAll('.tn-faq-item').forEach(function(el) { el.classList.remove('faq-active', 'open', 'is-open'); var content = el.querySelector('.tn-faq-content'); if (content) { content.style.removeProperty('height'); content.style.removeProperty('overflow'); } });
          if (!wasActive) item.classList.add('faq-active');
        });
      });
    });
  </script>
</TranslateNowLayout>