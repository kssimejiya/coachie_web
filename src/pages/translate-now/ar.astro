const FAQ_ITEMS = [
  { q: 'ما هو TranslateNow؟', a: 'TranslateNow هو تطبيق ترجمة بالذكاء الاصطناعي لنظام iOS يدعم أكثر من ١٣٥ لغة مع استنساخ الصوت وترجمة AR وترجمة المستندات وكاميرا OCR وإضافة لوحة مفاتيح وأدوات كتابة AI ووضع بدون إنترنت. يتكامل أيضاً مع اختصارات Siri وودجات الشاشة الرئيسية ومركز التحكم والأنشطة الحية وDynamic Island وبحث Spotlight وAPI مترجم النظام iOS 18.4+. طوّرته Coachie AI.' },
  { q: 'كيف يعمل استنساخ الصوت في TranslateNow؟', a: 'استنساخ الصوت يتيح لك تسجيل عينة صوتية مدتها ١٠ ثوانٍ يستخدمها ElevenLabs لإنشاء نسخة AI من صوتك تتحدث بأكثر من ١٣٥ لغة. يمكنك أيضاً تحميل ملف صوتي. اختر صوت ذكر أو أنثى، اضبط السرعة من ٠٫٥x إلى ٢x، واستمع للترجمات بصوتك مع نبرة طبيعية. استنساخ الصوت ميزة Pro.' },
  { q: 'ما هي ترجمة AR الفورية؟', a: 'ترجمة AR تستخدم ARKit للكشف عن النص عبر كاميرا iPhone وتضع بطاقات ترجمة ثلاثية الأبعاد عائمة glassmorphism مثبتة في الفضاء الحقيقي عبر SceneKit. وجّه الكاميرا نحو اللافتات أو القوائم أو المستندات — تظهر الترجمات عائمة في الفضاء ثلاثي الأبعاد. اضغط على أي بطاقة لنسخ النص أو سماع النطق TTS أو الشعور بالاستجابة اللمسية.' },
  { q: 'هل يستطيع TranslateNow ترجمة مستندات PDF وWord والنصوص؟', a: 'نعم، TranslateNow يترجم مستندات PDF وDOCX وTXT والصور مع الحفاظ على التخطيط. المحلل يستخرج كل كتلة نص، GPT-4o يترجم كل كتلة، ومحرك إعادة البناء يعيد بناء المستند مع الحفاظ على التنسيق والخطوط والتخطيط الأصلي. يشمل دعم RTL كامل للعربية والعبرية والأردية.' },
  { q: 'هل يمكنني الترجمة بدون إنترنت على iPhone؟', a: 'نعم، ٥٩ لغة متاحة للترجمة بدون إنترنت بالكامل على الجهاز عبر Google ML Kit. حمّل حزم اللغات مرة واحدة عبر WiFi (٥-٥٠ ميغابايت لكل منها)، ثم ترجم في أي مكان بدون إنترنت. صفر بيانات مُرسلة — كل المعالجة تبقى على iPhone.' },
  { q: 'كيف تعمل لوحة المفاتيح المترجمة؟', a: 'لوحة المفاتيح المترجمة هي إضافة لوحة مفاتيح iOS مدمجة تعمل في أي تطبيق بحقل نص — iMessage وWhatsApp وInstagram وTelegram وLinkedIn وGmail وSlack وأكثر. اكتب بلغتك، ولوحة المفاتيح تترجم وترسل باللغة المستهدفة دون تبديل التطبيقات.' },
  { q: 'ما أدوات الكتابة AI المتضمنة؟', a: 'TranslateNow يتضمن ٥ أدوات كتابة AI تعدّل النص قبل الترجمة: القواعد (تصحيح تلقائي)، النبرة (ودّي، مهني، مرح، غزلي، مبسّط)، الطول (موجز ٤٠-٦٠٪ أو موسّع ١٥٠-٢٠٠٪)، التنسيق (ملخص، نقاط رئيسية، قائمة)، والأسلوب (أكاديمي، إبداعي، شعري، مقنع). لا يوجد تطبيق ترجمة آخر لديه أدوات كتابة مدمجة.' },
  { q: 'هل يدعم TranslateNow Siri والودجات ومركز التحكم والأنشطة الحية؟', a: 'نعم، TranslateNow لديه تكامل عميق مع iOS. يشمل ٥ اختصارات Siri، ٣ أنواع ودجات شاشة رئيسية (ترجمة سريعة، ترجمات أخيرة، كلمة اليوم)، ٣ عناصر تحكم مركز التحكم iOS 18 (كاميرا، صوت، نص)، أنشطة حية على شاشة القفل وDynamic Island أثناء الجلسات، وفهرسة Spotlight لآخر ٥٠ ترجمة.' },
  { q: 'هل يمكنني جعل TranslateNow المترجم الافتراضي لـ iPhone؟', a: 'نعم، على iOS 18.4 والأحدث، TranslateNow يسجّل كمزوّد ترجمة النظام. عند تحديد نص في Safari أو Mail أو الرسائل والضغط على "ترجمة" في القائمة، الترجمة تمر عبر TranslateNow بدلاً من مترجم Apple المدمج.' },
  { q: 'كم يكلف TranslateNow؟', a: 'TranslateNow مجاني للتحميل مع ميزات ترجمة أساسية. الخطط المميزة: أسبوعي بـ ٩٫٩٩$/أسبوع (تجربة مجانية ٣ أيام) وشهري بـ ٢٩٫٩٩$/شهر (أفضل قيمة، وفّر ٢٥٪). كلا الخطتين تفتحان استنساخ الصوت وأدوات الكتابة AI وترجمة المستندات وترجمة AR وجميع الميزات المميزة. ألغِ في أي وقت عبر إدارة اشتراكات Apple.' },
  { q: 'ما الذي يجعل TranslateNow أفضل من Google Translate وDeepL؟', a: 'TranslateNow لديه ٢٢ ميزة لا يملكها Google Translate ولا DeepL. تشمل استنساخ صوت AI، ترجمة AR فورية مع ARKit، ٥ أدوات كتابة مدمجة، لوحة مفاتيح مترجمة لأي تطبيق، ترجمة مستندات مع إعادة بناء التخطيط، مترجم النظام (iOS 18.4+)، اختصارات Siri، ٣ ودجات شاشة رئيسية، عناصر مركز التحكم، أنشطة حية مع Dynamic Island، تسجيل محادثات .m4a، سياق AI مع أمثلة ومرادفات، نقحرة، ٩ نبرات، ٧ أصوات AI عصبية وتحكم بالسرعة.' },
  { q: 'هل يعمل TranslateNow في WhatsApp وiMessage وInstagram؟', a: 'نعم. إضافة لوحة المفاتيح المدمجة تعمل في أي تطبيق iOS بحقل نص — WhatsApp وiMessage وInstagram وTelegram وLinkedIn وGmail وSlack والبقية. فعّلها من الإعدادات ← عام ← لوحة المفاتيح ← لوحات المفاتيح ← إضافة لوحة مفاتيح ← TranslateNow.' },
  { q: 'كم لغة يدعم TranslateNow؟', a: 'TranslateNow يدعم أكثر من ١٣٥ لغة للترجمة السحابية عبر GPT-4o، ٥٩ لغة للترجمة بدون إنترنت على الجهاز عبر Google ML Kit، وواجهة التطبيق مترجمة إلى ٣٠ لغة تشمل الهندية والإسبانية والفرنسية والألمانية واليابانية والكورية والصينية والعربية والعبرية.' },
  { q: 'هل TranslateNow آمن للترجمات الخاصة؟', a: 'في وضع بدون إنترنت، كل معالجة الترجمة تحدث بالكامل على iPhone عبر ML Kit بدون إرسال أي بيانات. للميزات السحابية، النص يُعالج عبر APIs من OpenAI وElevenLabs مع تشفير قياسي. لا تُخزّن بيانات ترجمة على خوادم Coachie AI.' },
  { q: 'كيف أترجم رسائل WhatsApp على iPhone؟', a: 'لترجمة رسائل WhatsApp على iPhone، فعّل إضافة لوحة مفاتيح TranslateNow من الإعدادات ← عام ← لوحة المفاتيح ← لوحات المفاتيح ← إضافة لوحة مفاتيح ← TranslateNow. ثم افتح WhatsApp، اضغط رمز الكرة الأرضية على لوحة المفاتيح للتبديل إلى TranslateNow، اكتب رسالتك بلغتك، وتُترجم تلقائياً قبل الإرسال.' },
  { q: 'كيف أترجم مستند PDF على iPhone؟', a: 'لترجمة PDF على iPhone، افتح TranslateNow، اضغط على ميزة ترجمة المستندات واستورد PDF من الملفات أو iCloud أو البريد. التطبيق يستخرج جميع كتل النص، يترجم كل كتلة باستخدام GPT-4o، ويعيد بناء المستند مع الحفاظ على التنسيق والخطوط وتخطيط الصفحة الأصلي.' },
  { q: 'كيف أستخدم استنساخ الصوت للترجمة؟', a: 'لاستخدام استنساخ الصوت في TranslateNow، اذهب إلى الإعدادات ← استنساخ الصوت، سجّل عينة صوتية ١٠ ثوانٍ (أو حمّل ملف صوتي)، ومحرك ElevenLabs AI يُنشئ نسخة عصبية من صوتك. بعد الإنشاء، صوتك المستنسخ ينطق جميع الترجمات بأكثر من ١٣٥ لغة. اضبط السرعة من ٠٫٥x إلى ٢x واختر صوت ذكر أو أنثى. استنساخ الصوت يتطلب اشتراك Pro.' },
  { q: 'كيف أضبط مترجم افتراضي على iPhone iOS 18.4؟', a: 'لضبط TranslateNow كمترجم افتراضي على iOS 18.4 أو الأحدث، اذهب إلى الإعدادات ← التطبيقات ← TranslateNow وفعّل خيار مزوّد الترجمة. بعد التفعيل، في كل مرة تحدد نصاً في Safari أو Mail أو الرسائل وتضغط "ترجمة"، الترجمة تمر عبر TranslateNow بدلاً من مترجم Apple المدمج.' },
  { q: 'كيف أترجم نصاً بدون إنترنت على iPhone؟', a: 'للترجمة بدون إنترنت على iPhone، افتح TranslateNow، اذهب إلى الإعدادات ← اللغات بدون إنترنت، وحمّل حزم اللغات المطلوبة (٥-٥٠ ميغابايت لكل منها). بعد التحميل، الترجمة تعمل بدون اتصال بالإنترنت. ٥٩ لغة متاحة عبر ترجمة ML Kit على الجهاز. كل المعالجة تبقى على iPhone بدون إرسال بيانات.' },
  { q: 'هل TranslateNow أفضل من Google Translate؟', a: 'TranslateNow يقدم ٢٢ ميزة لا يملكها Google Translate، تشمل استنساخ الصوت، ترجمة AR فورية مع ARKit، إضافة لوحة مفاتيح لـ WhatsApp وiMessage، ٥ أدوات كتابة AI، ترجمة مستندات مع حفظ التخطيط، ٩ نبرات، مترجم النظام iOS 18.4+، وتكامل iOS عميق مع Siri والودجات ومركز التحكم وDynamic Island. Google Translate لديه لغات بدون إنترنت أكثر ومجاني بدون اشتراك.' },
  { q: 'هل TranslateNow أفضل من DeepL؟', a: 'TranslateNow يقدم ميزات أكثر بكثير من DeepL لمستخدمي iOS، تشمل استنساخ الصوت وترجمة AR وكاميرا OCR وإضافة لوحة مفاتيح و٥ أدوات كتابة AI ووضع بدون إنترنت بـ ٥٩ لغة وتكامل iOS عميق. TranslateNow يدعم أيضاً أكثر من ١٣٥ لغة مقابل ٣٠+ لـ DeepL. DeepL معروف بجودة ترجمة عالية للغات الأوروبية ولديه مستوى مجاني لترجمة النصوص.' },
];

