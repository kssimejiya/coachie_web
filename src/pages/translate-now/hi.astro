  </main>

  <!-- FAQ Override: resolves conflict between CSS .open, inline script, and GSAP initFAQ() -->
  <style is:inline>
    .tn-faq-content {
      height: auto !important;
      max-height: 0 !important;
      overflow: hidden !important;
      transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease !important;
      opacity: 0 !important;
    }
    .tn-faq-item.faq-active .tn-faq-content {
      max-height: 2000px !important;
      opacity: 1 !important;
    }
    .tn-faq-item.faq-active .tn-faq-chevron {
      transform: rotate(180deg);
    }
  </style>
  <script is:inline>
    window.addEventListener('load', function() {
      // Remove GSAP's inline height/overflow on FAQ content
      document.querySelectorAll('.tn-faq-content').forEach(function(c) {
        c.style.removeProperty('height');
        c.style.removeProperty('overflow');
      });

      // Clone all FAQ buttons to strip every existing listener (layout inline + GSAP)
      document.querySelectorAll('.tn-faq-btn').forEach(function(oldBtn) {
        var newBtn = oldBtn.cloneNode(true);
        oldBtn.parentNode.replaceChild(newBtn, oldBtn);

        newBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var item = newBtn.closest('.tn-faq-item');
          if (!item) return;
          var wasActive = item.classList.contains('faq-active');

          // Close all items (clear every class variant)
          document.querySelectorAll('.tn-faq-item').forEach(function(el) {
            el.classList.remove('faq-active', 'open', 'is-open');
            var content = el.querySelector('.tn-faq-content');
            if (content) {
              content.style.removeProperty('height');
              content.style.removeProperty('overflow');
            }
          });

          // Open clicked item if it wasn't already open
          if (!wasActive) {
            item.classList.add('faq-active');
          }
        });
      });
    });
  </script>
</TranslateNowLayout>