    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-gradient-dark);"><div class="max-w-6xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>使い方</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">TranslateNowで3ステップ翻訳</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">思考から翻訳された言葉まで2秒以下 — GPT-4oとオンデバイスMLが駆動。</p></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 relative" data-gsap-how><div class="hidden md:block absolute top-10 left-[20%] right-[20%] h-px" data-gsap-how-line style="background: linear-gradient(90deg, transparent, rgba(255,107,74,0.25), rgba(255,107,74,0.25), transparent);"></div>{STEPS.map((s) => (<div class="relative text-center group" data-gsap-step><div class="relative z-10 inline-flex flex-col items-center"><div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-2 transition-transform duration-300 group-hover:scale-105" data-gsap-step-icon style="background: linear-gradient(135deg, rgba(255,107,74,0.15), rgba(255,107,74,0.05)); border: 1px solid rgba(255,107,74,0.2);"><svg class="w-[26px] h-[26px]" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d={s.icon} /></svg></div><span class="text-[10px] font-bold tracking-[0.2em] uppercase mb-3" data-gsap-step-label style="color: var(--tn-soft-coral); font-family: var(--font-display);">ステップ {s.num}</span></div><h3 class="text-lg font-bold mb-2 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">{s.title}</h3><p class="text-sm leading-relaxed max-w-[280px] mx-auto" style="color: var(--tn-text-secondary);">{s.desc}</p></div>))}</div></div></section>

