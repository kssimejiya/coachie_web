              <div class="flex -space-x-0.5">{[...Array(5)].map(() => (<svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="var(--tn-coral-fire)" stroke="var(--tn-coral-fire)"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>))}</div>
              <span>最高評価のAI翻訳アプリ</span>
