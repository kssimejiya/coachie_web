  { '@type': 'HowToStep', position: 3, name: 'ネイティブのように会話', text: '135以上の言語で翻訳を取得、オンラインでもオフラインでも、あなたのクローンボイスで — 発音ガイド、例文、同義語付き。' },
]});

const orgSD = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: 'Coachie AI', url: 'https://coachie-ai.com', email: SUPPORT_EMAIL,
  description: 'Coachie AIはiOS・Android向けAIモバイルアプリを開発。TranslateNow: AI Translatorやウェルネスアプリ Coachieなど。',
  sameAs: ['https://apps.apple.com/in/app/translate-now-ai-translator/id6759827185', 'https://apps.apple.com/us/app/coachie-coach-chef-cbt/id6744700791'],
});
