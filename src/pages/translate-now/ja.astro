      <div class="tn-glass-card !p-0 overflow-hidden" style="cursor: default; transform: none !important;" data-gsap-comparison><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="text-left py-4 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle); font-family: var(--font-display);">機能</th><th class="text-center py-4 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-coral-fire); border-bottom: 1px solid var(--tn-bg-border-subtle); font-family: var(--font-display); background: rgba(255,107,74,0.04);">TranslateNow</th><th class="text-center py-4 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle); font-family: var(--font-display);">Google Translate</th><th class="text-center py-4 px-4 font-bold text-xs uppercase tracking-wider" style="color: var(--tn-text-muted); border-bottom: 1px solid var(--tn-bg-border-subtle); font-family: var(--font-display);">DeepL</th></tr></thead><tbody>{COMPARISON.map((r, i) => (<tr style={i < COMPARISON.length - 1 ? `border-bottom: 1px solid var(--tn-bg-border-subtle);` : ''}><td class="py-3.5 px-4 text-sm" style="color: var(--tn-text-secondary);">{r.feature}</td><td class="text-center py-3.5 px-4" style="background: rgba(255,107,74,0.02);">{r.tn === true ? (<div class="flex justify-center"><div class="w-6 h-6 rounded-full flex items-center justify-center" style="background: var(--tn-coral-bg);"><svg class="w-3.5 h-3.5" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg></div></div>) : <span class="text-xs font-medium" style="color: var(--tn-text-muted);">{r.tn}</span>}</td><td class="text-center py-3.5 px-4">{r.gt === true ? (<div class="flex justify-center"><div class="w-6 h-6 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.05);"><svg class="w-3.5 h-3.5" style="color: var(--tn-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg></div></div>) : r.gt === false ? (<div class="flex justify-center"><div class="w-6 h-6 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.03);"><svg class="w-3.5 h-3.5" style="color: var(--tn-text-hint);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div></div>) : <span class="text-xs font-medium" style="color: var(--tn-text-muted);">{r.gt}</span>}</td><td class="text-center py-3.5 px-4">{r.dl === true ? (<div class="flex justify-center"><div class="w-6 h-6 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.05);"><svg class="w-3.5 h-3.5" style="color: var(--tn-text-muted);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg></div></div>) : r.dl === false ? (<div class="flex justify-center"><div class="w-6 h-6 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.03);"><svg class="w-3.5 h-3.5" style="color: var(--tn-text-hint);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div></div>) : <span class="text-xs font-medium" style="color: var(--tn-text-muted);">{r.dl}</span>}</td></tr>))}</tbody></table></div></div></div></section>

    <section class="py-24 sm:py-32 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);"><div class="max-w-3xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>FAQ</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">よくある質問</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">TranslateNowについて知っておくべきすべて — 機能、料金、プライバシー、iOS統合。</p></div>
      <div class="space-y-2.5" data-gsap-faq-list>{FAQ_ITEMS.map((faq) => (<div class="tn-faq-item rounded-xl overflow-hidden transition-all duration-300" style="background: var(--tn-bg-surface); border: 1px solid var(--tn-bg-border-subtle);" data-gsap="fade-up"><button class="tn-faq-btn w-full flex items-center justify-between p-5 text-left transition-colors hover:bg-white/[0.02]"><h3 class="text-sm sm:text-[15px] font-semibold pr-4 leading-snug" style="color: var(--tn-text-primary); font-family: var(--font-display);">{faq.q}</h3><svg class="w-[18px] h-[18px] flex-shrink-0 tn-faq-chevron" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg></button><div class="tn-faq-content"><div class="px-5 pb-5"><p class="text-sm leading-relaxed" style="color: var(--tn-text-secondary);">{faq.a}</p></div></div></div>))}</div></div></section>

    <section class="py-16 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle);"><div class="max-w-3xl mx-auto text-center" data-gsap="fade-up"><h2 class="text-2xl sm:text-3xl font-extrabold mb-4 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">Coachie AIが開発</h2><p class="text-base leading-relaxed mb-4" style="color: var(--tn-text-secondary);">TranslateNowはCoachie AIが開発 — AI搭載iOS・Androidアプリに特化したモバイル開発スタジオ。App StoreとGoogle Playで複数のアプリをリリース。オンデバイス機械学習、クラウドAIサービス（OpenAI GPT-4o、ElevenLabs）、プラットフォーム深度統合（ARKit、Siri、WidgetKit、Live Activities、Jetpack Compose、ML Kit）を組み合わせ、実際のコミュニケーション課題を解決するツールを構築。</p><p class="text-sm leading-relaxed" style="color: var(--tn-text-muted);">ご質問やパートナーシップは <a href={`mailto:${SUPPORT_EMAIL}`} class="underline transition-colors hover:text-white/60" style="color: var(--tn-soft-coral);">{SUPPORT_EMAIL}</a> まで</p></div></section>

    <section class="py-24 sm:py-32 px-5 sm:px-6 lg:px-8 text-center relative overflow-hidden" id="download" style="background: var(--tn-bg-primary);" data-gsap-final-cta><div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] pointer-events-none" style="background: radial-gradient(circle, rgba(255,107,74,0.15) 0%, transparent 60%);" data-gsap-cta-glow></div><div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,107,74,0.2), transparent);"></div><div class="max-w-3xl mx-auto relative z-10"><Image src={translateIcon} alt="TranslateNowアイコン" class="w-16 h-16 rounded-2xl mx-auto mb-8" style="box-shadow: 0 8px 32px rgba(255,107,74,0.2), 0 0 0 1px rgba(255,255,255,0.08);" width={192} height={192} data-gsap-cta-icon /><h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-5 leading-tight tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">今日からすべての言語で話し始めよう</h2><p class="text-base sm:text-lg mb-10 leading-relaxed" style="color: var(--tn-text-secondary);">TranslateNowをApp Storeから無料ダウンロード。音声クローン、AR翻訳、ドキュメント、ライティングツール、オフライン & 135以上の言語。</p><div class="flex flex-col sm:flex-row items-center justify-center gap-4" data-gsap-cta-btn><a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn tn-coral-btn-large">無料ダウンロード<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a></div></div></section>

    <footer class="py-10 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle);" data-gsap-footer><div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left"><a href="/translate-now" class="flex items-center gap-2.5 no-underline group"><Image src={translateIcon} alt="TranslateNowアイコン" class="w-8 h-8 rounded-xl object-cover" style="box-shadow: 0 2px 8px rgba(0,0,0,0.3);" width={96} height={96} /><div><span class="font-bold text-sm block" style="color: var(--tn-text-primary); font-family: var(--font-display);">TranslateNow</span><span class="text-xs" style="color: var(--tn-text-muted);">by Coachie AI</span></div></a><div class="flex items-center gap-4 text-xs flex-wrap justify-center" style="color: var(--tn-text-muted);"><a href={PRIVACY_URL} class="hover:underline transition-colors hover:text-white/60" style="color: var(--tn-text-muted);">プライバシーポリシー</a><span style="color: var(--tn-bg-border-subtle);">·</span><a href={TERMS_URL} class="hover:underline transition-colors hover:text-white/60" style="color: var(--tn-text-muted);">利用規約</a><span style="color: var(--tn-bg-border-subtle);">·</span><a href={`mailto:${SUPPORT_EMAIL}`} class="hover:underline transition-colors hover:text-white/60" style="color: var(--tn-text-muted);">サポート</a>{LANGUAGE_LINKS.map((link) => (<><span style="color: var(--tn-bg-border-subtle);">·</span><a href={link.href} class="hover:underline transition-colors hover:text-white/60" style="color: var(--tn-text-muted);">{link.label}</a></>))}</div><div class="flex flex-col items-center md:items-end gap-1"><a href={`mailto:${SUPPORT_EMAIL}`} class="text-xs hover:underline transition-colors hover:text-white/60" style="color: var(--tn-text-muted);">{SUPPORT_EMAIL}</a><span class="text-[11px]" style="color: var(--tn-text-hint);">最終更新：2026年3月</span></div></div></footer>
  </main>

  <style is:inline>
    .tn-faq-content { height: auto !important; max-height: 0 !important; overflow: hidden !important; transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease !important; opacity: 0 !important; }
    .tn-faq-item.faq-active .tn-faq-content { max-height: 2000px !important; opacity: 1 !important; }
    .tn-faq-item.faq-active .tn-faq-chevron { transform: rotate(180deg); }
  </style>
  <script is:inline>
    window.addEventListener('load', function() {
      document.querySelectorAll('.tn-faq-content').forEach(function(c) { c.style.removeProperty('height'); c.style.removeProperty('overflow'); });
      document.querySelectorAll('.tn-faq-btn').forEach(function(oldBtn) {
        var newBtn = oldBtn.cloneNode(true); oldBtn.parentNode.replaceChild(newBtn, oldBtn);
        newBtn.addEventListener('click', function(e) {
          e.preventDefault(); e.stopPropagation();
          var item = newBtn.closest('.tn-faq-item'); if (!item) return;
          var wasActive = item.classList.contains('faq-active');
          document.querySelectorAll('.tn-faq-item').forEach(function(el) { el.classList.remove('faq-active', 'open', 'is-open'); var content = el.querySelector('.tn-faq-content'); if (content) { content.style.removeProperty('height'); content.style.removeProperty('overflow'); } });
          if (!wasActive) item.classList.add('faq-active');
        });
      });
    });
  </script>
