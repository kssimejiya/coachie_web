    <section class="py-24 sm:py-32 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);"><div class="max-w-6xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>Отзывы</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">Любимый пользователями по всему миру</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">Настоящие отзывы реальных людей, использующих TranslateNow каждый день.</p></div><div class="grid grid-cols-1 md:grid-cols-3 gap-4" data-gsap-testimonials>{TESTIMONIALS.map((t) => (<div class="tn-glass-card" data-gsap="fade-up"><div class="flex gap-0.5 mb-4">{[...Array(5)].map(() => (<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="var(--tn-coral-fire)" stroke="var(--tn-coral-fire)"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>))}</div><p class="text-sm leading-relaxed mb-5" style="color: var(--tn-text-tertiary);">«{t.text}»</p><div class="flex items-center gap-3"><div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold" style="background: var(--tn-coral-bg); color: var(--tn-coral-fire); font-family: var(--font-display);">{t.name.charAt(0)}</div><div><span class="text-sm font-semibold block" style="color: var(--tn-text-primary);">{t.name}</span><span class="text-xs" style="color: var(--tn-text-muted);">{t.role}</span></div></div></div>))}</div></div></section>

    <!-- COMPARISON TABLE -->
