      {LANGUAGE_LINKS.map((link) => (<a href={link.href} class="text-sm text-center px-4 py-2.5 rounded-xl no-underline transition-colors hover:bg-white/5" style="color: var(--tn-text-muted);">{link.label}</a>))}
      <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn w-full text-center mt-1">İndir</a>
