  </nav>

  <main id="main-content">
    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col justify-center px-5 sm:px-6 lg:px-8 pt-20 pb-12 overflow-hidden" style="background: var(--tn-bg-primary);" data-gsap-hero>
      <div class="absolute top-1/2 left-1/2 pointer-events-none" data-gsap-hero-glow style="width: 900px; height: 900px; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(255,107,74,0.12) 0%, rgba(255,107,74,0.04) 40%, transparent 70%);"></div>
      <div class="absolute top-1/4 left-1/4 pointer-events-none" data-gsap-parallax-glow data-gsap-parallax-speed="0.4" style="width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,143,107,0.06), transparent 70%); filter: blur(60px);"></div>
      <p class="sr-only">TranslateNow AI Translator iPhone uygulaması — ses klonlama, AR kamera çevirisi, belge çevirisi ve çevrimdışı mod ile 135+ dili çevirin.</p>
      <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-14 lg:gap-20">
          <div class="flex-1 text-center lg:text-left max-w-xl">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium mb-6" style="background: var(--tn-coral-bg); color: var(--tn-soft-coral); border: 1px solid rgba(255,107,74,0.12);" data-gsap-trust>
              <div class="flex -space-x-0.5">{[...Array(5)].map(() => (<svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="var(--tn-coral-fire)" stroke="var(--tn-coral-fire)"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>))}</div>
              <span>En Çok Beğenilen YZ Çevirmen</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold leading-[1.08] mb-6 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">Ses Klonlamalı YZ Çevirmen. <span class="tn-gradient-text">Kendi sesinizle konuşun.</span></h1>
            <h2 class="text-lg sm:text-xl font-medium mb-4 leading-relaxed max-w-lg mx-auto lg:mx-0" style="color: var(--tn-text-tertiary); font-family: var(--font-body);" data-gsap-hero-sub>AR çeviri, belgeler, yazım araçları, sistem çevirmen ve çevrimdışı mod ile 135+ dili çevirin</h2>
            <p class="text-base sm:text-lg mb-10 max-w-lg mx-auto lg:mx-0 leading-relaxed" style="color: var(--tn-text-secondary); font-family: var(--font-body);" data-gsap-hero-desc>TranslateNow ses klonlama, gerçek zamanlı AR katmanları (ARKit), belge çevirisi (PDF/DOCX/TXT), gerçek zamanlı YZ sohbetler, 5 yazım aracı, 9 ton, kamera OCR, her uygulama için klavye, Siri, widget'lar ve çevrimdışı cihaz üstü çeviri ile 135+ dili çevirir.</p>
            <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start" data-gsap-hero-cta>
              <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="tn-coral-btn tn-coral-btn-large" data-magnetic="0.25">App Store'dan Ücretsiz İndirin<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
            </div>
          </div>
          <div class="relative flex-shrink-0" data-gsap-hero-phone>
            <div class="tn-phone-glow" style="width: 400px; height: 700px;"></div>
            <div class="tn-phone-frame tn-phone-frame-large relative mx-auto"><div class="tn-phone-notch"></div><Image src={translateSs2} alt="TranslateNow YZ çeviri, bağlam, örnekler ve eş anlamlılar" class="w-full h-full object-cover" width={280} height={580} /><div class="tn-phone-reflection"></div></div>
            <div class="absolute hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-semibold" data-gsap-badge style="top: 8%; right: -30%; background: rgba(18,18,28,0.8); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.08); color: var(--tn-peach-glow); white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,0.3);"><span class="w-2 h-2 rounded-full" style="background: var(--tn-coral-fire); box-shadow: 0 0 6px rgba(255,107,74,0.5);"></span>135+ Dil</div>
            <div class="absolute hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-semibold" data-gsap-badge style="top: 42%; left: -38%; background: rgba(18,18,28,0.8); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.08); color: var(--tn-peach-glow); white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,0.3);"><span class="w-2 h-2 rounded-full" style="background: var(--tn-coral-fire); box-shadow: 0 0 6px rgba(255,107,74,0.5);"></span>Ses Klonlama</div>
            <div class="absolute hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-semibold" data-gsap-badge style="bottom: 12%; right: -28%; background: rgba(18,18,28,0.8); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.08); color: var(--tn-peach-glow); white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,0.3);"><span class="w-2 h-2 rounded-full" style="background: var(--tn-coral-fire); box-shadow: 0 0 6px rgba(255,107,74,0.5);"></span>Çevrimdışı hazır</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SOCIAL PROOF -->
    <section class="py-6 px-5 sm:px-6 lg:px-8 overflow-hidden" style="background: var(--tn-bg-surface); border-top: 1px solid var(--tn-bg-border-subtle); border-bottom: 1px solid var(--tn-bg-border-subtle);" data-gsap-social><div class="max-w-6xl mx-auto flex items-center justify-center gap-8 sm:gap-14 flex-wrap">{SOCIAL_PROOF.map((item) => (<div class="flex items-center gap-2 text-xs font-medium" style="color: var(--tn-text-muted);" data-gsap-social-item><svg class="w-4 h-4" style="color: var(--tn-soft-coral);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg><span>{item.label}</span></div>))}</div></section>

    <!-- CORE FEATURES -->
    <section class="py-24 sm:py-32 px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);"><div class="max-w-6xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>Temel Özellikler</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">Dokuz YZ Destekli Çeviri Modu</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">Ses, metin, kamera, AR, belgeler, klavye, sistem çevirmen, Siri ve çevrimdışı. Google Translate ve DeepL'de olmayan özellikler.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-gsap-card-grid>{FEATURES.map((f) => (<div class="tn-glass-card group" data-gsap="fade-up"><div class="tn-icon-box mb-4 transition-transform duration-300 group-hover:scale-110"><svg class="w-[22px] h-[22px]" style="color: var(--tn-soft-coral);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d={f.icon} /></svg></div><h3 class="text-lg font-bold mb-2 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">{f.title}</h3><p class="text-sm leading-relaxed" style="color: var(--tn-text-secondary);">{f.desc}</p></div>))}</div></div></section>

    <!-- HOW IT WORKS -->
    <section class="py-20 sm:py-24 px-5 sm:px-6 lg:px-8" style="background: var(--tn-gradient-dark);"><div class="max-w-6xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>Nasıl Çalışır</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">TranslateNow ile 3 Adımda Çeviri Yapın</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">Düşünceden çevrilmiş dile iki saniyenin altında — GPT-4o ve cihaz üstü ML tarafından desteklenir.</p></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 relative" data-gsap-how><div class="hidden md:block absolute top-10 left-[20%] right-[20%] h-px" data-gsap-how-line style="background: linear-gradient(90deg, transparent, rgba(255,107,74,0.25), rgba(255,107,74,0.25), transparent);"></div>{STEPS.map((s) => (<div class="relative text-center group" data-gsap-step><div class="relative z-10 inline-flex flex-col items-center"><div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-2 transition-transform duration-300 group-hover:scale-105" data-gsap-step-icon style="background: linear-gradient(135deg, rgba(255,107,74,0.15), rgba(255,107,74,0.05)); border: 1px solid rgba(255,107,74,0.2);"><svg class="w-[26px] h-[26px]" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d={s.icon} /></svg></div><span class="text-[10px] font-bold tracking-[0.2em] uppercase mb-3" data-gsap-step-label style="color: var(--tn-soft-coral); font-family: var(--font-display);">Adım {s.num}</span></div><h3 class="text-lg font-bold mb-2 tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">{s.title}</h3><p class="text-sm leading-relaxed max-w-[280px] mx-auto" style="color: var(--tn-text-secondary);">{s.desc}</p></div>))}</div></div></section>

    <!-- SCREENSHOTS -->
    <section class="py-24 sm:py-32 px-5 sm:px-6 lg:px-8 overflow-hidden" style="background: var(--tn-bg-primary);" data-gsap-gallery><div class="max-w-6xl mx-auto"><div class="text-center mb-14 md:mb-18" data-gsap-section-header><div class="tn-section-tag" data-gsap="fade-up"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>Uygulama Önizleme</div><h2 class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold mb-4 leading-[1.15] tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);" data-gsap="fade-up">TranslateNow'u İş Başında Görün</h2><p class="text-base sm:text-lg max-w-2xl leading-relaxed mx-auto" style="color: var(--tn-text-secondary);" data-gsap="fade-up">Ses klonlama, kamera, AR, belgeler — premium koyu arayüzde güçlü YZ çeviri araçları.</p></div><div class="flex gap-5 overflow-x-auto pb-6 snap-x snap-mandatory scrollbar-hide justify-start" data-gsap-gallery-track>{SCREENSHOTS.map((s) => (<div class="flex-shrink-0 snap-center flex flex-col items-center gap-3 group" data-gsap-shot><div class="tn-phone-frame transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-2xl" style="width: 200px; height: 420px;"><div class="tn-phone-notch"></div><Image src={s.image} alt={s.alt} class="w-full h-full object-cover" loading="lazy" width={400} height={840} /></div><span class="text-xs font-medium" style="color: var(--tn-text-muted);">{s.label}</span></div>))}</div></div></section>

    <!-- DEEP DIVES -->
    <section class="px-5 sm:px-6 lg:px-8" style="background: var(--tn-bg-primary);"><div class="max-w-6xl mx-auto">{DEEP_DIVES.map((f, idx) => (<div class={`min-h-screen flex flex-col justify-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row'} lg:items-center gap-12 lg:gap-20 py-12`} data-gsap-deepdive data-gsap-reversed={idx % 2 === 1 ? 'true' : 'false'}><div class="flex-1 max-w-lg" data-gsap-dd-text><span class="text-xs font-semibold uppercase tracking-[0.2em] mb-3 block" style="color: var(--tn-coral-fire); font-family: var(--font-display);" data-gsap-dd-tag>{f.tag}</span><h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold mb-4 leading-tight tracking-tight" style="color: var(--tn-text-primary); font-family: var(--font-display);">{f.title}</h3><p class="text-base leading-relaxed mb-6" style="color: var(--tn-text-secondary);">{f.desc}</p><ul class="space-y-3">{f.bullets.map((b) => (<li class="flex items-start gap-3 text-sm" style="color: var(--tn-text-tertiary);"><div class="tn-check-circle mt-0.5"><svg class="w-3 h-3" style="color: var(--tn-coral-fire);" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg></div><span>{b}</span></li>))}</ul></div><div class="flex-shrink-0" data-gsap-dd-phone><div class="relative"><div class="tn-phone-glow" style="width: 380px; height: 660px;"></div><div class="tn-phone-frame relative mx-auto"><div class="tn-phone-notch"></div><Image src={f.image} alt={f.imageAlt} class="w-full h-full object-cover" loading="lazy" width={260} height={540} /><div class="tn-phone-reflection"></div></div></div></div></div>))}</div></section>

    <!-- AI CONVERSATION -->
