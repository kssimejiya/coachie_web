            <span>Turkish</span>
            <svg class="w-3 h-3 transition-transform tn-lang-chevron" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </button>
          <div class="absolute right-0 top-full mt-2 py-2 rounded-xl opacity-0 invisible transition-all duration-200 tn-lang-menu" style="background: rgba(30,30,35,0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); min-width: 280px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); z-index: 100;">
            <a href="/translate-now/tr" class="px-3 py-1.5 text-xs no-underline transition-colors hover:bg-white/5" style="color: var(--tn-soft-coral); font-weight: 500;">Turkish</a>
            {LANGUAGE_LINKS.map((link) => (
              <a href={link.href} class="px-3 py-1.5 text-xs no-underline transition-colors hover:bg-white/5" style="color: var(--tn-text-muted);">{link.label}</a>
