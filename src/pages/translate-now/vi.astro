const FAQ_ITEMS = [
  { q: 'TranslateNow là gì?', a: 'TranslateNow là ứng dụng dịch thuật AI cho iOS hỗ trợ 135+ ngôn ngữ với nhân bản giọng nói, dịch AR, dịch tài liệu, camera OCR, tiện ích bàn phím, công cụ viết AI và chế độ ngoại tuyến. Ứng dụng cũng tích hợp với phím tắt Siri, widget màn hình chính, Trung tâm điều khiển, Live Activities, Dynamic Island, tìm kiếm Spotlight và API trình dịch hệ thống iOS 18.4+. Phát triển bởi Coachie AI.' },
  { q: 'Nhân bản giọng nói hoạt động như thế nào?', a: 'Nhân bản giọng nói cho phép bạn ghi mẫu giọng 10 giây mà ElevenLabs sử dụng để tạo bản sao AI giọng nói của bạn nói 135+ ngôn ngữ. Bạn cũng có thể tải lên file âm thanh. Chọn giọng nam hoặc nữ, điều chỉnh tốc độ từ 0,5x đến 2x, và nghe bản dịch bằng giọng nói của chính bạn. Nhân bản giọng nói là tính năng Pro.' },
  { q: 'Dịch AR thời gian thực là gì?', a: 'Dịch AR sử dụng ARKit để phát hiện văn bản qua camera iPhone và phủ thẻ dịch 3D nổi glassmorphism neo trong không gian thực qua SceneKit. Hướng camera vào biển hiệu, menu hoặc tài liệu — bản dịch xuất hiện lơ lửng trong 3D. Chạm vào bất kỳ thẻ nào để sao chép, nghe phát âm TTS hoặc cảm nhận phản hồi xúc giác.' },
  { q: 'TranslateNow có thể dịch tài liệu PDF, Word và văn bản không?', a: 'Có, TranslateNow dịch tài liệu PDF, DOCX, TXT và ảnh với giữ nguyên bố cục. Trình phân tích trích xuất mỗi khối văn bản, GPT-4o dịch từng khối, và công cụ tái tạo xây dựng lại tài liệu giữ nguyên định dạng, phông chữ và bố cục gốc. Bao gồm hỗ trợ RTL đầy đủ cho tiếng Ả Rập, Hebrew và Urdu.' },
  { q: 'Tôi có thể dịch ngoại tuyến không có internet trên iPhone không?', a: 'Có, 59 ngôn ngữ khả dụng cho dịch ngoại tuyến hoàn toàn trên thiết bị qua Google ML Kit. Tải gói ngôn ngữ một lần qua WiFi (5-50 MB mỗi gói), sau đó dịch ở bất kỳ đâu không cần internet. Không có dữ liệu nào được truyền đi — mọi xử lý đều trên iPhone.' },
  { q: 'Bàn phím dịch hoạt động như thế nào?', a: 'Bàn phím dịch là tiện ích mở rộng bàn phím iOS tích hợp hoạt động trong mọi ứng dụng có ô nhập văn bản — iMessage, WhatsApp, Instagram, Telegram, LinkedIn, Gmail, Slack và nhiều hơn. Gõ bằng ngôn ngữ của bạn, bàn phím dịch và gửi bằng ngôn ngữ đích mà không cần chuyển ứng dụng.' },
  { q: 'Những công cụ viết AI nào được bao gồm?', a: 'TranslateNow bao gồm 5 công cụ viết AI chỉnh sửa văn bản trước khi dịch: Ngữ pháp (tự động sửa), Giọng điệu (Thân thiện, Chuyên nghiệp, Hài hước, Tán tỉnh, Đơn giản), Độ dài (Ngắn gọn 40-60% hoặc Mở rộng 150-200%), Định dạng (Tóm tắt, Điểm chính, Danh sách), và Phong cách (Học thuật, Sáng tạo, Thơ ca, Thuyết phục). Không ứng dụng dịch nào khác có công cụ viết tích hợp.' },
  { q: 'TranslateNow có hỗ trợ Siri, widget, Trung tâm điều khiển và Live Activities không?', a: 'Có, TranslateNow có tích hợp iOS sâu. Bao gồm 5 phím tắt Siri, 3 loại widget màn hình chính (Dịch nhanh, Bản dịch gần đây, Từ vựng mỗi ngày), 3 điều khiển Trung tâm điều khiển iOS 18 (Camera, Giọng nói, Văn bản), Live Activities trên màn hình khóa và Dynamic Island trong phiên hoạt động, và lập chỉ mục Spotlight cho 50 bản dịch gần nhất.' },
  { q: 'Tôi có thể đặt TranslateNow làm trình dịch mặc định iPhone không?', a: 'Có, trên iOS 18.4 trở lên, TranslateNow đăng ký làm nhà cung cấp dịch hệ thống. Khi bạn chọn văn bản trong Safari, Mail hoặc Tin nhắn và chạm "Dịch" trong menu ngữ cảnh, bản dịch chạy qua TranslateNow thay vì trình dịch tích hợp của Apple.' },
  { q: 'TranslateNow giá bao nhiêu?', a: 'TranslateNow miễn phí tải về với tính năng dịch cơ bản. Gói Premium: Hàng tuần $9,99/tuần (dùng thử miễn phí 3 ngày) và Hàng tháng $29,99/tháng (giá trị tốt nhất, tiết kiệm 25%). Cả hai gói mở khóa nhân bản giọng nói, công cụ viết AI, dịch tài liệu, dịch AR và tất cả tính năng premium. Hủy bất kỳ lúc nào qua quản lý đăng ký Apple.' },
  { q: 'TranslateNow tốt hơn Google Translate và DeepL ở điểm nào?', a: 'TranslateNow có 22 tính năng mà cả Google Translate lẫn DeepL đều không có. Bao gồm nhân bản giọng nói AI, dịch AR thời gian thực với ARKit, 5 công cụ viết tích hợp, bàn phím dịch cho mọi ứng dụng, dịch tài liệu với tái tạo bố cục, trình dịch hệ thống (iOS 18.4+), phím tắt Siri, 3 widget màn hình chính, điều khiển Trung tâm điều khiển, Live Activities với Dynamic Island, ghi âm hội thoại .m4a, ngữ cảnh AI với ví dụ và từ đồng nghĩa, phiên âm, 9 giọng điệu, 7 giọng AI thần kinh và điều khiển tốc độ.' },
  { q: 'TranslateNow có hoạt động trong WhatsApp, iMessage và Instagram không?', a: 'Có. Tiện ích bàn phím tích hợp hoạt động trong mọi ứng dụng iOS có ô nhập văn bản — WhatsApp, iMessage, Instagram, Telegram, LinkedIn, Gmail, Slack và tất cả các ứng dụng khác. Kích hoạt trong Cài đặt → Cài đặt chung → Bàn phím → Bàn phím → Thêm bàn phím mới → TranslateNow.' },
  { q: 'TranslateNow hỗ trợ bao nhiêu ngôn ngữ?', a: 'TranslateNow hỗ trợ 135+ ngôn ngữ cho dịch đám mây qua GPT-4o, 59 ngôn ngữ cho dịch ngoại tuyến trên thiết bị qua Google ML Kit, và giao diện ứng dụng được bản địa hóa bằng 30 ngôn ngữ bao gồm tiếng Hindi, Tây Ban Nha, Pháp, Đức, Nhật, Hàn, Trung, Ả Rập và Hebrew.' },
  { q: 'TranslateNow có an toàn cho bản dịch riêng tư không?', a: 'Ở chế độ ngoại tuyến, mọi xử lý dịch diễn ra hoàn toàn trên iPhone qua ML Kit không truyền dữ liệu. Với tính năng đám mây, văn bản được xử lý qua API OpenAI và ElevenLabs với mã hóa tiêu chuẩn. Không có dữ liệu dịch nào được lưu trên máy chủ Coachie AI.' },
  { q: 'Cách dịch tin nhắn WhatsApp trên iPhone?', a: 'Để dịch tin nhắn WhatsApp trên iPhone, kích hoạt tiện ích bàn phím TranslateNow trong Cài đặt → Cài đặt chung → Bàn phím → Bàn phím → Thêm bàn phím mới → TranslateNow. Mở WhatsApp, chạm biểu tượng quả địa cầu trên bàn phím để chuyển sang TranslateNow, gõ tin nhắn bằng ngôn ngữ của bạn, và nó tự động dịch trước khi gửi.' },
  { q: 'Cách dịch tài liệu PDF trên iPhone?', a: 'Để dịch PDF trên iPhone, mở TranslateNow, chạm tính năng Dịch tài liệu và nhập PDF từ Tệp, iCloud hoặc email. Ứng dụng trích xuất tất cả khối văn bản, dịch từng khối bằng GPT-4o, và tái tạo tài liệu giữ nguyên định dạng, phông chữ và bố cục trang gốc.' },
  { q: 'Cách sử dụng nhân bản giọng nói để dịch?', a: 'Để sử dụng nhân bản giọng nói trong TranslateNow, vào Cài đặt → Nhân bản giọng nói, ghi mẫu giọng 10 giây (hoặc tải lên file âm thanh), và công cụ AI ElevenLabs tạo bản sao thần kinh giọng nói của bạn. Sau khi tạo, giọng nhân bản phát âm tất cả bản dịch bằng 135+ ngôn ngữ. Điều chỉnh tốc độ từ 0,5x đến 2x và chọn giọng nam hoặc nữ. Nhân bản giọng nói yêu cầu đăng ký Pro.' },
  { q: 'Cách đặt trình dịch mặc định trên iPhone iOS 18.4?', a: 'Để đặt TranslateNow làm trình dịch mặc định trên iOS 18.4 trở lên, vào Cài đặt → Ứng dụng → TranslateNow và bật tùy chọn Nhà cung cấp dịch. Sau khi bật, mỗi khi bạn chọn văn bản trong Safari, Mail hoặc Tin nhắn và chạm "Dịch" trong menu ngữ cảnh, bản dịch chạy qua TranslateNow thay vì trình dịch tích hợp Apple.' },
  { q: 'Cách dịch văn bản ngoại tuyến trên iPhone không có internet?', a: 'Để dịch ngoại tuyến trên iPhone, mở TranslateNow, vào Cài đặt → Ngôn ngữ ngoại tuyến, và tải gói ngôn ngữ cần thiết (5-50 MB mỗi gói). Sau khi tải, dịch hoạt động không cần kết nối internet. 59 ngôn ngữ khả dụng qua dịch ML Kit trên thiết bị. Mọi xử lý đều trên iPhone không truyền dữ liệu.' },
  { q: 'TranslateNow có tốt hơn Google Translate không?', a: 'TranslateNow cung cấp 22 tính năng mà Google Translate không có, bao gồm nhân bản giọng nói, dịch AR thời gian thực với ARKit, tiện ích bàn phím cho WhatsApp và iMessage, 5 công cụ viết AI, dịch tài liệu giữ nguyên bố cục, 9 giọng điệu, trình dịch hệ thống iOS 18.4+, và tích hợp iOS sâu với Siri, widget, Trung tâm điều khiển và Dynamic Island. Google Translate có nhiều ngôn ngữ ngoại tuyến hơn và miễn phí không cần đăng ký.' },
  { q: 'TranslateNow có tốt hơn DeepL không?', a: 'TranslateNow cung cấp nhiều tính năng hơn đáng kể so với DeepL cho người dùng iOS, bao gồm nhân bản giọng nói, dịch AR, camera OCR, tiện ích bàn phím, 5 công cụ viết AI, chế độ ngoại tuyến với 59 ngôn ngữ và tích hợp iOS sâu. TranslateNow cũng hỗ trợ 135+ ngôn ngữ so với 30+ của DeepL. DeepL nổi tiếng với chất lượng dịch cao cho ngôn ngữ châu Âu và có gói miễn phí cho dịch văn bản.' },
];

